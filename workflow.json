{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/workflow.schema.json",
  "workflow_id": "litigation_analyst_v2",
  "steps": [
    {
      "id": "prepare_case_sources",
      "kind": "source",
      "label": "Plan · Inventory source records",
      "goal": "Inventory and normalize legal sources with exact provenance.",
      "needs": [],
      "control": {
        "timeout_seconds": 3600
      }
    },
    {
      "id": "build_case_indexes",
      "kind": "stage",
      "label": "Plan · Map evidence and relationships",
      "goal": "Build and validate the frozen document index and observed graph before investigation.",
      "needs": [
        "prepare_case_sources"
      ],
      "control": {
        "timeout_seconds": 99999
      }
    },
    {
      "id": "scope_case_review",
      "kind": "stage",
      "label": "Plan · Check source scope",
      "goal": "Verify the indexes, identify handling restrictions and bind the investigation to its frozen records.",
      "needs": [
        "build_case_indexes"
      ],
      "control": {
        "timeout_seconds": 3600
      }
    },
    {
      "id": "draft_case_questions",
      "kind": "stage",
      "label": "Plan · Draft investigation questions",
      "goal": "Propose neutral questions from the brief and authorized source samples.",
      "needs": [
        "scope_case_review"
      ],
      "control": {
        "timeout_seconds": 3600
      }
    },
    {
      "id": "review_case_questions",
      "kind": "stage",
      "label": "Plan · Review questions in Chat",
      "goal": "Let the supervisor edit the list and add questions before starting evidence work.",
      "needs": [
        "draft_case_questions"
      ],
      "control": {
        "timeout_seconds": 90000
      }
    },
    {
      "id": "investigate_case_evidence",
      "kind": "stage",
      "label": "Execute · Investigate the questions",
      "goal": "Test neutral hypotheses against bounded document and graph evidence.",
      "needs": [
        "review_case_questions"
      ],
      "control": {
        "timeout_seconds": 99999
      }
    },
    {
      "id": "write_review_draft",
      "kind": "sink",
      "label": "Execute · Publish the case brief",
      "goal": "Verify exact citations and publish a source-linked interactive investigation, immutable snapshot history and review draft.",
      "needs": [
        "investigate_case_evidence"
      ],
      "control": {
        "timeout_seconds": 3600
      }
    }
  ],
  "defaults": {
    "step": {
      "control": {
        "failure_policy": "fail_workflow",
        "retry": {
          "max_attempts": 1
        }
      }
    }
  },
  "child_workflows": {
    "investigate_case_evidence": {
      "planner": "plan_litigation_round",
      "templates": {
        "plan_litigation_round": {
          "control": {
            "timeout_seconds": 600,
            "retry": {
              "max_attempts": 1
            }
          },
          "input_schema": {
            "type": "object",
            "required": []
          }
        },
        "collect_litigation_evidence": {
          "run": {
            "block": {
              "uses": "mn.blocks.domain_operation@1",
              "hooks": {
                "operation": "domain.round_tasks:collect_evidence"
              },
              "input_schema": {
                "type": "object",
                "required": [
                  "task",
                  "_child"
                ]
              },
              "limits": {
                "max_calls": 1,
                "timeout_seconds": 600
              }
            }
          },
          "control": {
            "timeout_seconds": 600,
            "retry": {
              "max_attempts": 1
            }
          },
          "input_schema": {
            "type": "object",
            "required": [
              "task"
            ]
          }
        },
        "check_counterevidence": {
          "run": {
            "block": {
              "uses": "mn.blocks.domain_operation@1",
              "hooks": {
                "operation": "domain.round_tasks:check_counterevidence"
              },
              "input_schema": {
                "type": "object",
                "required": [
                  "task",
                  "_child"
                ]
              },
              "limits": {
                "max_calls": 1,
                "timeout_seconds": 600
              }
            }
          },
          "control": {
            "timeout_seconds": 600,
            "retry": {
              "max_attempts": 1
            }
          },
          "input_schema": {
            "type": "object",
            "required": [
              "task"
            ]
          }
        },
        "assess_litigation_hypothesis": {
          "run": {
            "block": {
              "uses": "mn.blocks.domain_operation@1",
              "hooks": {
                "operation": "domain.round_tasks:assess_hypothesis"
              },
              "input_schema": {
                "type": "object",
                "required": [
                  "task",
                  "_child"
                ]
              },
              "limits": {
                "max_calls": 1,
                "timeout_seconds": 600
              }
            }
          },
          "control": {
            "timeout_seconds": 600,
            "retry": {
              "max_attempts": 1
            }
          },
          "input_schema": {
            "type": "object",
            "required": [
              "task"
            ]
          }
        },
        "review_litigation_finding": {
          "run": {
            "block": {
              "uses": "mn.blocks.domain_operation@1",
              "hooks": {
                "operation": "domain.round_tasks:review_finding"
              },
              "input_schema": {
                "type": "object",
                "required": [
                  "task",
                  "_child"
                ]
              },
              "limits": {
                "max_calls": 1,
                "timeout_seconds": 600
              }
            }
          },
          "control": {
            "timeout_seconds": 600,
            "retry": {
              "max_attempts": 1
            }
          },
          "input_schema": {
            "type": "object",
            "required": [
              "task"
            ]
          }
        },
        "summarize_litigation_round": {
          "run": {
            "block": {
              "uses": "mn.blocks.domain_operation@1",
              "hooks": {
                "operation": "domain.round_tasks:summarize_round"
              },
              "input_schema": {
                "type": "object",
                "required": [
                  "task",
                  "_child"
                ]
              },
              "limits": {
                "max_calls": 1,
                "timeout_seconds": 600
              }
            }
          },
          "control": {
            "timeout_seconds": 600,
            "retry": {
              "max_attempts": 1
            }
          },
          "input_schema": {
            "type": "object",
            "required": [
              "task"
            ]
          }
        }
      },
      "inputs": {
        "seed": [
          "outputs",
          "result"
        ]
      },
      "outputs": {
        "result": [
          "result"
        ]
      },
      "max_rounds": 3,
      "max_steps_per_round": 33
    }
  }
}
